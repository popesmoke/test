# Virello Scanner backend environment variables

# Storage: discord (recommended), postgres, or sqlite
STORAGE_MODE=discord

# Discord txt-file sync channel (scanner database)
DISCORD_SYNC_CHANNEL_ID=1512910527473389608
DISCORD_BOT_TOKEN=
# Alias for DISCORD_BOT_TOKEN
DISCORD_TOKEN=

# PostgreSQL — only if STORAGE_MODE=postgres. Leave empty to use Discord sync + SQLite locally.
DATABASE_URL=

# Legacy gzip backup (postgres mode only)
DISCORD_BACKUP_CHANNEL_ID=
BACKUP_ENABLED=true
BACKUP_AUTO_RESTORE=true
BACKUP_INTERVAL_DAYS=29

# API auth
API_TOKEN_SECRET=change-me-to-a-long-random-secret
SUPER_ADMIN_DISCORD_IDS=1262056594993315943

# Discord OAuth (reviewer login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://virello-secure.onrender.com/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_ACCESS_ROLE_ID=

# Frontend (Cloudflare Pages)
FRONTEND_URL=https://virello-secure.pages.dev
# Comma-separated allowed origins — include your Cloudflare Pages URL and custom domain
CORS_ORIGINS=https://virello-secure.pages.dev

# Stripe (card checkout — optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe Price ID per plan, e.g. STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEMIANNUAL=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_DUO=
STRIPE_PRICE_ENTERPRISE_10=
STRIPE_PRICE_ENTERPRISE_20=

# Shoppex store (crypto + PayPal F&F checkout)
# Store URL is public — also set VITE_SHOPPEX_STORE_URL on Cloudflare Pages.
SHOPPEX_STORE_URL=https://your-store.shoppex.store
SHOPPEX_API_KEY=
SHOPPEX_GATEWAYS=BITCOIN,LITECOIN,USDT,SOLANA,PAYPAL
# From Shoppex → Settings → Webhooks (endpoint must be your Render backend URL)
SHOPPEX_WEBHOOK_SECRET=
SHOPPEX_DYNAMIC_WEBHOOK_URL=https://virello-secure.onrender.com/webhooks/shoppex/dynamic
# Comma-separated if you have multiple DYNAMIC products (one secret per product)
SHOPPEX_DYNAMIC_WEBHOOK_SECRET=
# Bot on Render — backend notifies it to grant purchaser role + license after Shoppex payment
BOT_FULFILLMENT_URL=https://bot1-zocn.onrender.com
BOT_FULFILLMENT_SECRET=
# Bot calls back to sync license grants/revokes (e.g. /claim) — same secret as above
# Optional product IDs after running scripts/sync_shoppex_listings.py
SHOPPEX_PRODUCT_MONTHLY=
SHOPPEX_PRODUCT_SEMIANNUAL=
SHOPPEX_PRODUCT_YEARLY=
SHOPPEX_PRODUCT_DUO=
SHOPPEX_PRODUCT_ENTERPRISE_10=
SHOPPEX_PRODUCT_ENTERPRISE_20=

# Landing demo video fallback when admin has not set one
DEMO_VIDEO_URL=
